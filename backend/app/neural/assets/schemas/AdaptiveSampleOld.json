{
    "name": "AdaptiveExercizes",
    "strict": true,
    "schema": {
        "type": "object",
        "properties": {
                "expected_result_for_the_user": { "type": "string" },
                "description_of_changes_for_the_user": { "type": "string" },
                "change_exercizes": {
                    "type": ["array", "null"],
                    "items": {
                        "type": "object",
                        "properties": {
                            "exercize_id": { "type": "integer" },
                            "new_exercize_id": { "type": "integer" },
                            "why_changed": { "type": "string" }
                    },
                    "required": ["exercize_id", "why_changed", "new_exercize_id"],
                    "additionalProperties": false
                }
            }
        },
        "required": ["change_exercizes", "description_of_changes_for_the_user", "expected_result_for_the_user"],
        "additionalProperties": false
    }
}